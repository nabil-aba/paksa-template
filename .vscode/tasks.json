{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 1. Run Android (Debug & Test)",
            "type": "shell",
            "command": "paksa-tools run",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": false },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "💎 2. Build APK (Rilis Resmi)",
            "type": "shell",
            "command": "paksa-tools release",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": false },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "🔑 3. Bikin Kunci Gembok (Keystore)",
            "type": "shell",
            "command": "paksa-tools keygen",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": false },
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        }
    ]
}
